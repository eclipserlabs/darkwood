<Layouts.app flash={@flash}>
  <section class="mx-auto max-w-md rounded-2xl border border-slate-800 bg-slate-950 p-8 shadow-2xl">
    <p class="text-xs font-semibold uppercase tracking-[0.3em] text-amber-400">Darkwood access</p>
    <h1 class="mt-3 text-3xl font-semibold text-white">Join the incident room</h1>
    <p class="mt-2 text-sm text-slate-400">
      Choose the name collaborators will see while you are connected.
    </p>
    <form id="join-form" action={~p"/join"} method="post" class="mt-8 space-y-4">
      <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
      <input :if={@return_to} type="hidden" name="return_to" value={@return_to} />
      <label class="block text-sm font-medium text-slate-200" for="display-name">Display name</label>
      <input
        id="display-name"
        name="display_name"
        required
        minlength="1"
        maxlength="80"
        autofocus
        class="w-full rounded-lg border border-slate-700 bg-slate-900 px-4 py-3 text-white outline-none focus:border-amber-400"
      />
      <p :if={@error} id="join-error" class="text-sm text-red-400">{@error}</p>
      <button
        id="join-submit"
        class="w-full rounded-lg bg-amber-400 px-4 py-3 font-semibold text-slate-950 transition hover:bg-amber-300"
      >Enter Darkwood</button>
    </form>
  </section>
</Layouts.app>
